
@model IEnumerable<Practical_6.Models.Product>

<h2>Product Catalog</h2>

<p>
    @Html.ActionLink("Add New Product", "Create")
</p>

<table border="1" cellpadding="10">
    <tr>
        <th>ID</th>
        <th>Product Name</th>
        <th>Price</th>
        <th>Actions</th>
    </tr>

    @foreach (var product in Model)
    {
        <tr>
            <td>@product.Id</td>
            <td>@product.Name</td>
            <td>₹@product.Price</td>
            <td>
                @Html.ActionLink("Edit", "Edit",
                    new { id = product.Id })
                |
                @Html.ActionLink("Delete", "Delete",
                    new { id = product.Id })
            </td>
        </tr>
    }
</table>
